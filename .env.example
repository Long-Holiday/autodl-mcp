# Copy to .env; uv run autodl-mcp loads .env from the working directory.
# Browser DevTools -> Network -> instance request -> Authorization header.
# Use the console login token unchanged, not a Pro developer token or Bearer prefix.
AUTODL_TOKEN=
# Alternatively point to a UTF-8 token file (chmod 600); environment token wins.
AUTODL_TOKEN_FILE=
# Optional comma-separated exact instance UUIDs; empty allows all owned instances.
AUTODL_INSTANCE_ALLOWLIST=
AUTODL_RETRY_INTERVAL=60
AUTODL_RETRY_MAX_INTERVAL=300
# Wait uniformly between 70% and 100% of the capped backoff, including at the cap.
AUTODL_RETRY_JITTER=0.3
AUTODL_TRANSIENT_RETRY_INTERVAL=60
AUTODL_TRANSIENT_RETRY_MAX_INTERVAL=900
# Retry-After may require a longer cooldown than these local ceilings.
# 0 means unlimited capacity waiting; jobs disappear when the server exits.
AUTODL_MAX_WAIT_SECONDS=0
AUTODL_POLL_INTERVAL=5
AUTODL_START_TIMEOUT=600
AUTODL_REQUEST_TIMEOUT=30
# Only add a code after confirming that it exclusively means no idle GPU/machine.
AUTODL_CAPACITY_CODES=
